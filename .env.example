DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本地默认 SQLite；Docker 使用 PostgreSQL。
# DATABASE_URL=postgres://teaching:password@localhost:5432/teaching
# Docker 使用独立密码（建议随机字母数字，避免URL保留字符）。
POSTGRES_PASSWORD=replace-with-random-database-password
RABBITMQ_PASSWORD=replace-with-random-queue-password
# 生产域名：DEBUG=0，设置 ALLOWED_HOSTS、APP_URL、CSRF_TRUSTED_ORIGINS。
DOMAIN=teaching.example.com
TASKS_EAGER=1
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# 兼容 chat/completions 的视觉模型服务，必须支持图片和 JSON 输出。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
OCR_PROVIDER=vision
# 仅在真实样本验证通过后启用客观题自动定分。
AUTO_GRADING_ENABLED=0
MAX_BATCH_PAGES=100
MAX_AI_CALLS_PER_BATCH=110
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
